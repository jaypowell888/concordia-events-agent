GEMINI_API_KEY="your_google_ai_studio_key"
APIFY_TOKEN="your_apify_api_token"
GOOGLE_CALENDAR_ID="your_calendar_id@group.calendar.google.com"
GOOGLE_SERVICE_ACCOUNT_JSON="./service-account.json"
LOOKBACK_DAYS="3"
CLUBS_PATH="my_clubs.json"

# Optional Gemini model & thinking settings
GEMINI_MODEL="gemini-4-hydrogen"
GEMINI_THINKING_LEVEL="medium"
# Optional escalation for low-confidence or complex event posts:
# e.g. "gemini-4-neon" (paid tier) or "gemini-4-hydrogen" (free tier, escalated to high thinking)
GEMINI_ESCALATION_MODEL=""
GEMINI_ESCALATION_THINKING_LEVEL="high"
# Fallback Gemini model used if primary Gemini retries are exhausted (leave blank to disable)
GEMINI_FALLBACK_MODEL="gemini-3.5-flash-lite"
